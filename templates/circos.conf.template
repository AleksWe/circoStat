<ideogram>
    <spacing>
        default = 0.005r
        <pairwise anurchr>
            spacing = 5r
        </pairwise>
    </spacing>

    # Ideogram position, fill and outline
    radius = 0.90r
    thickness = 20p
    fill = yes
    fill_color = black
    stroke_color = black
    stroke_thickness = 2p

    # Minimum definition for ideogram labels.
    show_label = no
    label_font = default
    label_radius = dims(ideogram,radius_inner) -50p
    label_size = 45
    label_parallel = yes
</ideogram>

<image>
    <<include etc/image.conf>>
</image>

<<include etc/colors_fonts_patterns.conf>>
<<include etc/housekeeping.conf>>